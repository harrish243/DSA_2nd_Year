class Solution {
    public int pivotIndex(int[] nums) {
        int left = 0;
        int right = 0;
        int total=0;
        for(int i =0 ; i < nums.length;i++)
        {
            total += nums[i];
        }

        for(int j =0 ; j < nums.length;j++)
        {
            if(j>0)
            {
                left += nums[j-1];
            }
            right = total - left - nums[j];

            if(left == right)
            {
                return j;
            }
        }
    return -1;
    }
}
