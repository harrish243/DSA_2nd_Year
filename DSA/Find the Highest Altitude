class Solution {
    public int largestAltitude(int[] gain) {
        int lar = 0;
        int alt = 0;
        for(int i =0; i < gain.length;i++)
        {
            alt = alt + gain[i];
       
            if(lar <= alt )
            {
                lar = alt;
            }
        }
        return lar;
    }
}