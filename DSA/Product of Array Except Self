# 238

# Input: nums = [1,2,3,4]
# Output: [24,12,8,6]

class Solution(object):
    def productExceptSelf(self, nums):
        
        answer = []

        for i in range(len(nums)):
            
            product = 1

            for j in range(len(nums)):

                if j == i:
                    continue
                product *= nums[j]

            answer.append(product)

        return answer
            
        
